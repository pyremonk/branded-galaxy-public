#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$SCRIPT_DIR/.env.local"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Error: .env.local not found at $ENV_FILE"
  exit 1
fi

if [[ $# -ne 1 ]]; then
  echo "Usage: ./local_mode -on | -off"
  exit 1
fi

mode="$1"
tmp_file="$ENV_FILE.tmp"

case "$mode" in
  -on)
    awk '
      /^\s*#?\s*VITE_SUPABASE_URL=/ { sub(/^\s*#?\s*/, "# "); print; next }
      /^\s*#?\s*VITE_SUPABASE_ANON_KEY=/ { sub(/^\s*#?\s*/, "# "); print; next }
      { print }
    ' "$ENV_FILE" > "$tmp_file"
    mv "$tmp_file" "$ENV_FILE"
    echo "Local mode ON: Supabase env vars commented out in .env.local"
    ;;
  -off)
    awk '
      /^\s*#\s*VITE_SUPABASE_URL=/ { sub(/^\s*#\s*/, ""); print; next }
      /^\s*#\s*VITE_SUPABASE_ANON_KEY=/ { sub(/^\s*#\s*/, ""); print; next }
      { print }
    ' "$ENV_FILE" > "$tmp_file"
    mv "$tmp_file" "$ENV_FILE"
    echo "Local mode OFF: Supabase env vars uncommented in .env.local"
    ;;
  *)
    echo "Invalid flag: $mode"
    echo "Usage: ./local_mode -on | -off"
    exit 1
    ;;
esac
